{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm vercel-build",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/watchdog",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/news",
      "schedule": "30 1,5,9,13,17,21 * * *"
    }
  ]
}
