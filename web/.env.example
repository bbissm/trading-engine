# Postgres, in das die Engine schreibt. Neon-URL (HTTP-Treiber) oder normales Postgres (node-postgres).
# Ohne DATABASE_URL zeigen die Seiten einen Einrichtungshinweis.
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres

# Anmeldung (Better Auth, ein Benutzer). Ohne TE_PASSWORD ist die App lokal offen;
# auf Vercel (production/preview) antwortet sie dann mit 503.
TE_ADMIN_EMAIL=
TE_PASSWORD=
# mind. 32 zufällige Bytes; Ändern macht gespeicherte TOTP-Geheimnisse unlesbar
BETTER_AUTH_SECRET=
# öffentliche Basis-URL (bestimmt Passkey-Origin und RP-ID)
BETTER_AUTH_URL=http://localhost:3000
# optional: Bearer-Token für Skripte auf /api/ops/* (mind. 32 Zeichen); nie für Step-up-Aktionen
TE_API_TOKEN=

# Vercel-Cron (Watchdog): Vercel sendet Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Benachrichtigung (optional; ohne diese Variablen nur In-App)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Nur im Vercel-Build: Passwort der Engine-Datenbankrolle te_engine (mind. 32 alphanumerische Zeichen)
TE_ENGINE_DB_PASSWORD=

# optional: Poolgrösse für node-postgres (Standard 5)
# DATABASE_POOL_MAX=5
