# Postgres, in das die Engine schreibt. Neon-URL (HTTP-Treiber) oder normales Postgres (node-postgres).
# Ohne DATABASE_URL zeigen die Seiten einen Einrichtungshinweis.
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres

# Übergangs-Login (ein Benutzer, signiertes Cookie). Ohne TE_PASSWORD ist die App lokal offen;
# auf Vercel (production/preview) antwortet sie dann mit 503.
# TODO(E0-4): wird durch Passkey + TOTP + Step-up ersetzt, bevor es Live-Bedienelemente gibt.
TE_PASSWORD=
# optional, Standard "admin"; erscheint als user:<name> in command.issued_by und audit_event.actor
TE_USER=admin
# optional: zusätzliches Geheimnis für die Session-Signatur (Ändern meldet alle Geräte ab)
SESSION_SECRET=

# optional: Poolgrösse für node-postgres (Standard 5)
# DATABASE_POOL_MAX=5
